# ==========================================
# Git MCP Server - Local Single Image Dockerfile
# ==========================================

# --- 阶段 1: 前端构建 ---
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

# 安装依赖
COPY frontend/package*.json ./
RUN npm install

# 复制源码并构建
COPY frontend/ ./
RUN npm run build

# --- 阶段 2: 运行环境 ---
FROM python:3.13-slim
WORKDIR /app

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 复制后端源码
COPY . .

# 复制前端编译结果到 src/static (覆盖源码中可能存在的旧文件)
COPY --from=frontend-builder /app/frontend/build ./src/static

# 创建必要的目录
RUN mkdir -p /data/git_repos /app/logs

# 设置环境变量
ENV PYTHONPATH=/app
ENV CONFIG_PATH=/app/config/config.yml

# 暴露端口
EXPOSE 3001

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -f http://localhost:3001/health || exit 1

# 启动服务
CMD ["sh", "-c", "uvicorn src.server:create_app --factory --host 0.0.0.0 --port 3001 --no-access-log"]
